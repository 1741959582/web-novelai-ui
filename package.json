{
  "name": "web-novelai-ui",
  "version": "0.1.6",
  "private": true,
  "description": "NAI Studio Web UI",
  "type": "module",
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npm run dev:tauri",
    "dev:frontend": "npm run --workspace apps/frontend dev",
    "dev:tauri": "tauri dev --config src-tauri/tauri.conf.json",
    "build": "npm run build:tauri",
    "build:frontend": "npm run --workspace apps/frontend build",
    "build:tauri": "tauri build --config src-tauri/tauri.conf.json --config src-tauri/tauri.release.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAI Studio Web UI",
  "version": "0.1.9",
  "identifier": "com.langbai.novelai-studio",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../apps/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NAI Studio Web UI",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "backgroundColor": "#0e0f21",
        "resizable": true,
        "incognito": false,
        "devtools": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": ["resources/DirectML.dll"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
